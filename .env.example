# AI Coaching Agent - platform configuration example.
# Placeholders only. Copy to .env and adjust locally.
#
# ---------------------------------------------------------------------------
# READ THIS FIRST: eight names below are shared by two to four components.
#
# In ten separate repositories that was invisible. In one process reading one
# environment it means you CANNOT express "UC-02 on the company adapter, UC-04
# still on mock" - one name, one value, several readers, and their registries
# accept different keys. Setting COURSES_PROVIDER=acme satisfies UC-07 and makes
# UC-02 refuse to start on an unknown registry key.
#
# That loud failure is the architecture working as designed. It is also why the
# config namespace, not the code, is what blocks a staged rollout of real
# adapters. See PLATFORM_CONTRACT.md section 11 for the recommendation
# (prefix everything UCnn_, the convention UC-01 and UC-09 already use).
#
# Shared names are marked  # SHARED: uc.., uc..  below.
# ---------------------------------------------------------------------------


# ===========================================================================
# UC-01  Coaching session initiation          (fully namespaced already)
# ===========================================================================
UC01_ENV=development
UC01_DEV_MODE=true
UC01_HOST=127.0.0.1
UC01_PORT=8000
UC01_SERVE_FRONTEND=true
UC01_PERSISTENCE=sqlite
UC01_DATABASE_PATH=./data/uc01.sqlite3
UC01_AUTO_MIGRATE=true
UC01_NARIC_ADAPTER=mock
UC01_COURSES_ADAPTER=mock
UC01_CASES_ADAPTER=mock
UC01_PROFILE_ADAPTER=mock
# Replace before any deployment touching real data (brief section 9.1).
UC01_IDENTITY_PROVIDER=dev
UC01_MOCK_NARIC=per_user
UC01_MOCK_COURSES=available
UC01_MOCK_CASES=available
UC01_MOCK_PROFILE=available
UC01_DEV_SCENARIO_HEADER=true
UC01_LOG_LEVEL=INFO
UC01_LOG_FORMAT=json
UC01_EXPOSE_ERROR_DETAILS=false


# ===========================================================================
# UC-02  Contextual awareness setup
# ===========================================================================
ENVIRONMENT=development
NARIC_PROVIDER=mock                  # SHARED with UC-01 (as UC01_NARIC_ADAPTER)
COURSES_PROVIDER=mock                # SHARED: uc02, uc04, uc07 - DIFFERENT allowed values
LEGAL_PROVIDER=mock
HISTORY_PROVIDER=mock
PROVIDER_TIMEOUT_MS=2000
CONTEXT_ASSEMBLY_BUDGET_MS=3000
QUESTION_HISTORY_LIMIT=20
CONTEXT_TTL_HOURS=12
ALLOW_DEV_SESSION_IDS=false          # SHARED: uc02, uc04, uc05, uc06 - one switch, four components
DEBUG_CONTEXT_ENDPOINT=false
ALLOW_FORCE_REFRESH=false
# Development identity shim. Replace before any deployment touching real data.
DEV_USER_ID_HEADER=X-User-Id
INTERNAL_ADMIN_HEADER=X-Internal-Admin
LOG_LEVEL=INFO                       # SHARED: uc02, uc05, uc08, uc10
USER_ID_LOG_SALT=replace-me-with-a-deployment-secret


# ===========================================================================
# UC-03  Legal concept Q&A
# ===========================================================================
# UC-03 ships no .env.example; it is configured through uc03/config.py
# defaults. Its distinctness threshold (0.60) is a fake-generator number - see
# docs/DECISIONS.md, "Thresholds tuned against fake generators".


# ===========================================================================
# UC-04  Course content coaching
# ===========================================================================
ANSWER_GENERATOR=fake                # SHARED: uc04, uc06
LEARNER_CONTEXT_PROVIDER=mock        # SHARED: uc04, uc05, uc06
QUIZ_CLASSIFIER=mock
CONCEPT_TAGGER=mock
CURRENT_USER_PROVIDER=header         # SHARED: uc04, uc05, uc06, uc07
INTERACTION_LOG_REPOSITORY=memory    # SHARED: uc04, uc05, uc06 - the four writers (contract section 9)
FRAMING_REGISTRY=memory
GENERATION_TIMEOUT_MS=10000          # SHARED: uc04, uc05, uc06
GENERATION_TARGET_P95_MS=3000        # SHARED: uc04, uc05, uc06 - fake-generator figure
QUIZ_MATCH_THRESHOLD=0.85            # fake-generator figure; re-measure (brief section 4.4)
GENERATION_PROVIDER=
GENERATION_MODEL=
GENERATION_API_KEY=


# ===========================================================================
# UC-05  Socratic method coaching
# ===========================================================================
GENERATOR=fake
INTENT_CLASSIFIER=mock
DIALOGUE_REPOSITORY=memory
SESSION_MODE_REPOSITORY=memory       # resolves onto UC-01's session record (brief section 6)
SOCRATIC_EXCHANGE_CAP=5
LOOP_SIMILARITY_THRESHOLD=0.8        # fake-generator figure; re-measure
GENERATOR_PROVIDER=
GENERATOR_MODEL=
GENERATOR_API_KEY=
GENERATOR_BASE_URL=
LEARNER_CONTEXT_BASE_URL=
LEARNER_CONTEXT_API_KEY=
SESSION_MODE_FILE=


# ===========================================================================
# UC-06  Case-linked coaching
# ===========================================================================
CASE_FILE_PROVIDER=mock
GUARD_CLASSIFIER=mock
SESSION_HALT_REPOSITORY=memory
ADMIN_ALERT_SINK=memory
SECURITY_INCIDENT_SINK=memory
# Enabling a real generator here is gated in code by
# CONFIDENTIALITY_SIGN_OFF_RECORDED = False (Decision 8). Do not flip that
# constant to unblock a test - no test needs it.


# ===========================================================================
# UC-07  Progress and knowledge gap report
# ===========================================================================
INTERACTION_LOG_PROVIDER=mock        # resolves onto the shared store (contract section 9)
FEEDBACK_PROVIDER=mock               # resolves onto UC-10
PROFILE_PROVIDER=mock
GAP_REPORT_THRESHOLD=10
MIN_TOPIC_AREAS=3
EXPLAIN_DIFFERENTLY_STRUGGLE_THRESHOLD=2   # see contract section 9.4: null vs zero
LOW_RATING_STRUGGLE_THRESHOLD=1
FOLLOW_UP_STRUGGLE_THRESHOLD=2
TOPIC_DESCRIPTION_REGISTRY_PATH=uc07/config/topic_descriptions.json
MOCK_SCENARIO=struggle_mixed
CURRENT_USER_HEADER=X-User-Id


# ===========================================================================
# UC-08  Learning streaks and milestones
# ===========================================================================
ACTIVITY_PROVIDER=mock               # resolves onto the shared store
GAP_REPORT_PROVIDER=mock             # resolves onto UC-07
STREAK_WINDOW_HOURS=24
BADGE_MILESTONES=10,50,100
FREEZE_MIN_STREAK_DAYS=7
FREEZE_PER_CALENDAR_MONTH=1
FREEZE_OFFER_EXPIRY_HOURS=24
WEEKLY_SUMMARY_DAY=monday            # UC-08 ships no scheduler; you drive it (brief section 7.2)
PERSISTENCE=memory
PERSISTENCE_DIR=.uc08-data
PROVIDER_TIMEOUT_SECONDS=5.0
ALLOW_DEV_SESSION_MINTING=false      # SHARED: uc08, uc10
DEV_IDENTITY_HEADER=X-UC08-Subject


# ===========================================================================
# UC-09  Session summary and CPD export     (fully namespaced already)
# ===========================================================================
UC09_SESSION_PROVIDER=mock           # resolves onto UC-01
UC09_INTERACTION_PROVIDER=mock       # resolves onto the shared store
UC09_CITATION_PROVIDER=mock          # resolves onto UC-03 and UC-06 authority records
UC09_GAP_REPORT_PROVIDER=mock        # resolves onto UC-07
UC09_SUMMARY_GENERATOR=fake
UC09_DOCUMENT_RENDERER=simple
UC09_SUMMARY_REPOSITORY=memory
UC09_DOWNLOAD_LOG_REPOSITORY=memory
UC09_CLOCK=system
UC09_CURRENT_USER_PROVIDER=header
UC09_PROVIDER_TIMEOUT_SECONDS=5.0
UC09_ALLOW_DEV_SESSION_MINTING=false
UC09_UPSTREAM_BASE_URL=
UC09_UPSTREAM_API_KEY=
UC09_LOG_LEVEL=INFO
UC09_LOG_JSON=true


# ===========================================================================
# UC-10  Feedback and content review flagging
# ===========================================================================
INTERACTION_PROVIDER=mock            # resolves onto the shared store
FLAG_DOWN_RATE_THRESHOLD=0.30
FLAG_MINIMUM_SAMPLE_SIZE=10          # Decision 5 - the company must confirm this number
FLAG_WINDOW_DAYS=7
HISTORICAL_RATING_WINDOW_HOURS=24
DEV_ADMIN_TOKEN=
