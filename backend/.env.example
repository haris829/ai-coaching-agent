# Copy to backend/.env and adjust. `.env` is gitignored — never commit real credentials.
#
# DATABASE
# The company database has not been provisioned yet, so local development uses a file-backed
# SQLite database. When it is, change ONLY this line, e.g.
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/quizagent
#   DATABASE_URL=mysql+pymysql://user:pass@host:3306/quizagent
# then run `alembic upgrade head`. See docs/DATABASE.md.
DATABASE_URL=sqlite:///./quiz_agent.db
DATABASE_ECHO=false

ENVIRONMENT=development
LOG_LEVEL=INFO

# The interface and port to bind. Loopback in development on purpose. A deployment does not set
# HOST at all: outside a development environment the server binds 0.0.0.0 by itself, and PORT is
# read from the platform's own variable (Railway, Render, Heroku and Fly all inject it).
HOST=127.0.0.1
PORT=8000

# Vite dev-server origins for the test UI.
#
# A single-service deployment needs NONE of this: the API serves the built UI itself, so the browser
# only makes same-origin requests and CORS is absent rather than configured. Set FRONTEND_DIST
# (below) and leave this empty. It exists for local development, where Vite runs on its own port.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory of the built frontend to serve at /. Empty means API-only.
#   FRONTEND_DIST=/app/frontend/dist
FRONTEND_DIST=

# ---------------------------------------------------------------------------
# GUARDS — both are REQUIRED outside a development environment
# ---------------------------------------------------------------------------
# The application refuses to start with either of these unset when ENVIRONMENT is anything other
# than development/dev/test/local. That refusal is deliberate: both guards are no-ops while unset,
# and the symptom is silent — nothing errors, they simply admit everybody.
#
# Administrator guard. Empty in local development: identity still resolves from the placeholder
# directory, but an anonymous caller may also read and write the question bank — and question-bank
# reads carry `isCorrect`, which is the answer key. Setting this closes that path.
ADMIN_API_TOKEN=

# Service-to-service guard for the platform-internal endpoints (UC-09): the session monitor
# reporting a formal assessment's disconnect, the certificate service asking whether it may
# generate, and the review-queue recovery sweep. Separate from the administrator token because
# those callers are not administrators — and a learner able to declare their own examination
# disconnected could auto-submit it. Unset, an administrator credential is accepted instead, which
# is fine locally and not in a deployment.
SYSTEM_API_TOKEN=

# ---------------------------------------------------------------------------
# REVIEW DEPLOYMENTS
# ---------------------------------------------------------------------------
# A review deployment is a real deployment — public URL, real guards, real database — whose purpose
# is for someone to try the system out. These two switches are what make that possible without
# weakening anything, and both are OFF by default.

# Whether GET /api/session lists the placeholder directory's identities AND THEIR TOKENS, which is
# how the test UI switches between an administrator, a learner and an assessor with no login screen.
#
# Deliberately independent of ENVIRONMENT. A deployed environment must set ADMIN_API_TOKEN to have
# working guards at all, which puts it outside the development safe-list — and a reviewer would then
# face an API they cannot authenticate to. Turning this on is a decision, visible in the
# environment, and absent from a real production deployment.
DEMO_IDENTITIES=false

# Create the demo course, three quizzes and four identities at start-up if the database is empty.
# Idempotent; never reconfigures a quiz that already has an active configuration version, so a
# redeploy cannot publish a version behind a reviewer's back or disturb an attempt already locked
# to one. Ignored outright under ENVIRONMENT=test.
AUTO_SEED=false

# Tokens for the seeded identities. The built-in fallbacks (admin-token, learner-token, …) are
# published in this repository, so `seed` REFUSES to write them into a non-development environment.
# Generate your own for anything with a URL.
SEED_ADMIN_TOKEN=
SEED_LEARNER_TOKEN=
SEED_LEARNER2_TOKEN=
SEED_ASSESSOR_TOKEN=

# CSV import limits.
CSV_MAX_BYTES=5242880
CSV_MAX_ROWS=5000


# ATTEMPT DELIVERY (UC-03)
# Extra seconds a write is tolerated past an attempt's hard expiry. 0 matches the specification:
# nothing is accepted once time has elapsed. Raise it only to absorb network latency for an
# autosave already in flight.
SUBMISSION_GRACE_SECONDS=0
# Advertised to clients: if a device clock differs from the server's by more than this, the client
# must resync. Advisory only — a client clock never affects remaining time.
CLOCK_RESYNC_THRESHOLD_SECONDS=5
# Autosave cadence the server advertises to clients.
AUTOSAVE_INTERVAL_SECONDS=30
# Ceiling on one batch autosave request.
MAX_BATCH_ANSWERS=500

# AI COACHING REVIEW MODE (UC-07)
# Coaching policy. The threshold is the number of completed exchanges after which the learner is
# offered the choice between continuing Socratic coaching and a direct concept explanation.
DIRECT_EXPLANATION_THRESHOLD=5
# Hard ceiling on exchanges within one coaching session. Not a teaching rule — a runaway guard.
COACHING_MAX_EXCHANGES=50
# How many trailing messages are replayed to the model as conversation context.
COACHING_HISTORY_WINDOW=20
# Consecutive AI failures after which a session is parked as FAILED and needs an explicit retry.
COACHING_MAX_CONSECUTIVE_FAILURES=3
# Longest learner message accepted into a coaching session.
COACHING_MAX_MESSAGE_CHARS=4000
# In-request regenerations allowed when a coach reply breaks the coaching policy. Exhausting them
# fails the exchange; it never falls back to a canned response.
COACHING_POLICY_RETRIES=1

# The AI provider. LEAVE BOTH EMPTY AND COACHING REPORTS ITSELF UNAVAILABLE — which is the truth,
# and is what a stock deployment does. It never degrades into invented teaching text: the rest of the
# quiz chain is completely unaffected, and the coaching action is simply not offered.
#
# Set COACHING_LLM_PROVIDER=anthropic together with a key to bind the shipped adapter.
# The key is read from the environment only. It is never committed, never logged, and never returned
# by any endpoint.
COACHING_LLM_PROVIDER=
COACHING_LLM_API_KEY=
COACHING_LLM_MODEL=claude-sonnet-5
COACHING_LLM_BASE_URL=https://api.anthropic.com
COACHING_LLM_TIMEOUT_SECONDS=20
COACHING_LLM_MAX_OUTPUT_TOKENS=700
# Replies longer than this are treated as an invalid model response rather than forwarded.
COACHING_LLM_MAX_OUTPUT_CHARS=4000

# RETAKE MANAGEMENT (UC-08)
# Which immutable configuration version a retake locks. ACTIVE_AT_RETAKE is UC-03's rule for any new
# attempt and is the default, so a retake behaves like any other attempt. CARRY_FORWARD_PREVIOUS
# pins it to the version the previous attempt ran under. An unrecognised value refuses to start
# rather than silently falling back — a deployment that meant to pin retakes and instead advanced
# them would not notice until a learner sat one under changed rules.
RETAKE_CONFIGURATION_POLICY=ACTIVE_AT_RETAKE
# Upper bound on a single administrator grant. A guard against a mistyped grant, not a product rule.
MAX_GRANT_ADDITIONAL_ATTEMPTS=10

# FORMAL ASSESSMENT MODE (UC-09)
# The version of the conditions text a learner acknowledges, recorded on the acknowledgement so
# "which conditions did this learner agree to?" stays answerable after the wording changes. Bump it
# when the conditions change: older acknowledgements stop satisfying the gate and learners re-read.
FORMAL_CONDITIONS_VERSION=2026.1
# Publish attempts the recovery service makes before leaving a review-queue entry for an operator.
# The entry is never discarded and the certificate stays blocked either way — this bounds noise.
REVIEW_QUEUE_MAX_PUBLISH_ATTEMPTS=5
# How long the authoritative device session may go without a heartbeat before the platform's session
# monitor may call it disconnected. UC-09 runs no timer of its own; this is the number it publishes
# so the monitor and the module agree on one threshold.
SESSION_HEARTBEAT_TIMEOUT_SECONDS=90

# ANALYTICS & REPORTING (UC-10)
# Wrong-answer percentage above which a question is flagged for content review. Strictly greater
# than, so a threshold of 40 flags at 40.1% and not at 40%.
ANALYTICS_FLAG_THRESHOLD=40
# Graded responses a question needs before it can be flagged at all, so one wrong answer is not
# treated as evidence of a bad question.
ANALYTICS_FLAG_MIN_RESPONSES=5
# Wall-clock budget for one analytics query; an administrator can also cancel in flight.
ANALYTICS_QUERY_TIMEOUT_SECONDS=30
ANALYTICS_PAGE_SIZE=500
# Safety stop: abort aggregation once this many records have been scanned, so a mis-specified filter
# cannot exhaust memory.
ANALYTICS_MAX_SCANNED_RECORDS=5000000
ANALYTICS_EXPORT_MAX_ROWS=100000
# Explicit acceptance of DANGEROUS analytics values — a 0.1% flag threshold, for instance, which
# would flag virtually every question and make the review queue meaningless. Off by default; the
# /config/validate endpoint reports what it would allow before anyone turns it on.
ANALYTICS_ALLOW_DANGEROUS_CONFIGURATION=false
