# UC-10 Feedback & Improvement -- configuration
# Provider selection is a registry lookup (uc10/adapters/registry.py).
# An unknown value fails loudly at startup; there is never a silent fallback to a mock.
INTERACTION_PROVIDER=mock

# Content review flagging policy. Read through ThresholdConfigProvider at evaluation time.
FLAG_DOWN_RATE_THRESHOLD=0.30
# ASSUMED BY US -- requires company confirmation (see docs/assumptions.md A-01).
FLAG_MINIMUM_SAMPLE_SIZE=10
FLAG_WINDOW_DAYS=7

# Server-side window for rating a historical response, measured from interaction delivery time.
HISTORICAL_RATING_WINDOW_HOURS=24

# Dev-only session minting. MUST stay false on any production path.
ALLOW_DEV_SESSION_MINTING=false

LOG_LEVEL=INFO

# Dev-only admin credential for the replaceable admin identity adapter.
# Unset => admin endpoints deny every request. Never a production auth mechanism.
DEV_ADMIN_TOKEN=
