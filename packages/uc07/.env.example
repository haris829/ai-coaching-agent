# UC-07 Progress & Knowledge Gap Identification -- example configuration.
# Placeholders only. No secrets, no real URLs.

# ---- Provider selection (resolved through the provider registry) ----
# Allowed values are whatever is registered in uc07/composition.py.
# An unknown value fails loudly at startup. There is NO silent fallback to mock.
INTERACTION_LOG_PROVIDER=mock
FEEDBACK_PROVIDER=mock
PROFILE_PROVIDER=mock
COURSES_PROVIDER=mock

# ---- Analysis thresholds (business rules live in config, not in code) ----
GAP_REPORT_THRESHOLD=10
MIN_TOPIC_AREAS=3
EXPLAIN_DIFFERENTLY_STRUGGLE_THRESHOLD=2
LOW_RATING_STRUGGLE_THRESHOLD=1
FOLLOW_UP_STRUGGLE_THRESHOLD=2

# ---- Topic description registry (never generated, never inferred) ----
TOPIC_DESCRIPTION_REGISTRY_PATH=uc07/config/topic_descriptions.json

# ---- Mock scenario selection (mock adapters only; ignored by real adapters) ----
MOCK_SCENARIO=struggle_mixed

# ---- Local dev identity (replaceable CurrentUserProvider; NOT production auth) ----
CURRENT_USER_PROVIDER=header
CURRENT_USER_HEADER=X-User-Id

# ---- Real adapter placeholders (copy uc07/adapters/real/_template.py) ----
# COMPANY_INTERACTION_LOG_BASE_URL=<PLACEHOLDER>
# COMPANY_INTERACTION_LOG_TOKEN=<PLACEHOLDER>
# COMPANY_PROVIDER_TIMEOUT_SECONDS=5.0
