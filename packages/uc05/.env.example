# UC-05 Socratic Method Coaching -- example configuration.
# Placeholders only. No real keys, no real URLs, ever, in this file.

# ---------------------------------------------------------------------------
# Provider selection. Each value is a registry key; changing one is the entire
# config half of an integration swap. An unregistered key fails at startup.
# ---------------------------------------------------------------------------
GENERATOR=fake
LEARNER_CONTEXT_PROVIDER=mock
INTENT_CLASSIFIER=mock
DIALOGUE_REPOSITORY=memory
# `memory` loses mode state on restart; `jsonfile` survives one.
SESSION_MODE_REPOSITORY=memory
INTERACTION_LOG_REPOSITORY=memory
CURRENT_USER_PROVIDER=header

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
SOCRATIC_EXCHANGE_CAP=5
LOOP_SIMILARITY_THRESHOLD=0.8

# ---------------------------------------------------------------------------
# Latency. GENERATION_TIMEOUT_MS is enforced; GENERATION_TARGET_P95_MS is a
# target and is logged, not enforced.
# ---------------------------------------------------------------------------
GENERATION_TIMEOUT_MS=10000
GENERATION_TARGET_P95_MS=3000

# ---------------------------------------------------------------------------
# Gates
# ---------------------------------------------------------------------------
ALLOW_DEV_SESSION_IDS=false

# ---------------------------------------------------------------------------
# Real-provider settings. Unused while GENERATOR=fake. There is deliberately
# no default that could reach a network.
# ---------------------------------------------------------------------------
GENERATOR_PROVIDER=
GENERATOR_MODEL=
GENERATOR_API_KEY=
GENERATOR_BASE_URL=

LEARNER_CONTEXT_BASE_URL=
LEARNER_CONTEXT_API_KEY=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Used only when SESSION_MODE_REPOSITORY=jsonfile.
SESSION_MODE_FILE=

LOG_LEVEL=INFO
