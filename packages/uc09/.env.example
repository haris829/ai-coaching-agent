# UC-09 configuration. Copy to .env and edit. Every value has a safe default;
# this file exists to show what exists, not because anything must be set.

# -- provider selection -----------------------------------------------------
# Each value names a registered implementation in uc09_summary/registry.py.
# A name with no implementation stops startup, by design. There is no silent
# fallback to a mock.
UC09_SESSION_PROVIDER=mock
UC09_INTERACTION_PROVIDER=mock
UC09_CITATION_PROVIDER=mock
UC09_GAP_REPORT_PROVIDER=mock
UC09_SUMMARY_GENERATOR=fake
UC09_DOCUMENT_RENDERER=simple
UC09_SUMMARY_REPOSITORY=memory
UC09_DOWNLOAD_LOG_REPOSITORY=memory
UC09_CLOCK=system
UC09_CURRENT_USER_PROVIDER=header

# -- behaviour --------------------------------------------------------------
UC09_PROVIDER_TIMEOUT_SECONDS=5.0

# This component receives an opaque session_id and never creates one on a
# production path. Leave this off outside local development.
UC09_ALLOW_DEV_SESSION_MINTING=false

# -- upstream, used only by real adapters -----------------------------------
# The whole test suite runs with these unset.
UC09_UPSTREAM_BASE_URL=
UC09_UPSTREAM_API_KEY=

# -- logging ----------------------------------------------------------------
UC09_LOG_LEVEL=INFO
UC09_LOG_JSON=true
