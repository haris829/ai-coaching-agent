# UC-01 — Coaching Session Initiation. Copy to `.env` and adjust.
# Every value below is optional; the defaults shown are what the app uses.
# Real environment variables always win over this file.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
UC01_ENV=development
# Developer mode. Must be false in any shared deployment: it is the master switch
# for the dev scenario header and the error `debug` block.
UC01_DEV_MODE=true
UC01_HOST=127.0.0.1
UC01_PORT=8000
# Serve the reference UI at / (set false to run API-only).
UC01_SERVE_FRONTEND=true

# ---------------------------------------------------------------------------
# Persistence (standalone development store — see docs/PERSISTENCE.md)
# ---------------------------------------------------------------------------
# sqlite | memory
UC01_PERSISTENCE=sqlite
UC01_DATABASE_PATH=./data/uc01.sqlite3
# Apply pending migrations on startup. Set false to run them explicitly with
#   python -m uc01.persistence.migrate
UC01_AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# Adapter selection — THE integration switch
# ---------------------------------------------------------------------------
# mock = development fixture adapter (shipped).
# real = your adapter in uc01/adapters/real/, registered in uc01/api/container.py.
# Setting `real` before implementing the adapter fails loudly with instructions.
UC01_NARIC_ADAPTER=mock
UC01_COURSES_ADAPTER=mock
UC01_CASES_ADAPTER=mock
UC01_PROFILE_ADAPTER=mock
# dev = header-based development identity. Replace with the company auth provider.
UC01_IDENTITY_PROVIDER=dev

# ---------------------------------------------------------------------------
# Mock scenarios (ignored once an adapter is set to `real`)
# ---------------------------------------------------------------------------
# naric:   per_user | success | incomplete | calibrating | unavailable | invalid
UC01_MOCK_NARIC=per_user
# courses: available | empty | unavailable | invalid
UC01_MOCK_COURSES=available
# cases:   available | empty | unavailable | invalid
UC01_MOCK_CASES=available
# profile: available | incomplete | unavailable
UC01_MOCK_PROFILE=available
# Allow the X-Dev-Scenarios request header to override the above per request.
# Requires UC01_DEV_MODE=true; forced off otherwise.
UC01_DEV_SCENARIO_HEADER=true

# ---------------------------------------------------------------------------
# Logging and error detail
# ---------------------------------------------------------------------------
UC01_LOG_LEVEL=INFO
# json | text
UC01_LOG_FORMAT=json
# Developer-only: adds a `debug` block with technical detail to error responses.
# Requires UC01_DEV_MODE=true. Never enable in a shared environment.
UC01_EXPOSE_ERROR_DETAILS=false
