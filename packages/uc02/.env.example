# UC-02 Contextual Awareness Setup - example configuration.
# Placeholders only. Copy to .env and adjust locally.

ENVIRONMENT=development

# Provider selection: "mock" today. "company" once a real adapter exists
# (see uc02/infrastructure/providers/company/ and docs/integration.md).
NARIC_PROVIDER=mock
COURSES_PROVIDER=mock
LEGAL_PROVIDER=mock
HISTORY_PROVIDER=mock

# Timing
PROVIDER_TIMEOUT_MS=2000
CONTEXT_ASSEMBLY_BUDGET_MS=3000

# Assembly rules
QUESTION_HISTORY_LIMIT=20
CONTEXT_TTL_HOURS=12

# Guarded switches - keep all three false in production
ALLOW_DEV_SESSION_IDS=false
DEBUG_CONTEXT_ENDPOINT=false
ALLOW_FORCE_REFRESH=false

# Identity (replaceable development shim - see docs/integration.md)
DEV_USER_ID_HEADER=X-User-Id
INTERNAL_ADMIN_HEADER=X-Internal-Admin

# Logging
LOG_LEVEL=INFO
USER_ID_LOG_SALT=replace-me-with-a-deployment-secret
