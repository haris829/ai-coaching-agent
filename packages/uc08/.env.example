# UC-08 Learning Streaks and Milestones -- configuration
#
# Copy to .env for local work. No secrets belong in this file, and no URL in
# this component is invented: a real upstream URL is read by the adapter that
# talks to it (see docs/INTEGRATION.md).

# --- provider selection (resolved through uc08/registry.py) ------------------
# An unregistered name fails at startup and names the missing implementation.
# There is no silent fallback to a mock.
ACTIVITY_PROVIDER=mock
GAP_REPORT_PROVIDER=mock

# --- streak rules -----------------------------------------------------------
# The rolling qualifying window, in hours, evaluated from the current UTC time.
STREAK_WINDOW_HOURS=24
BADGE_MILESTONES=10,50,100
FREEZE_MIN_STREAK_DAYS=7
# Must be 1: the platform streak record carries a single freeze_used_at, so a
# larger allowance is not representable (A-11).
FREEZE_PER_CALENDAR_MONTH=1
# How long an unanswered freeze offer stays acceptable (A-12).
FREEZE_OFFER_EXPIRY_HOURS=24

# --- weekly summary ---------------------------------------------------------
WEEKLY_SUMMARY_DAY=monday

# --- local infrastructure ---------------------------------------------------
# memory | jsonfile. Neither is a production database.
PERSISTENCE=memory
PERSISTENCE_DIR=.uc08-data
PROVIDER_TIMEOUT_SECONDS=5.0
LOG_LEVEL=INFO

# --- session identity -------------------------------------------------------
# UC-08 receives an opaque session_id and never creates one on a production
# path. Leave this false outside local development.
ALLOW_DEV_SESSION_MINTING=false
# Minimal replaceable identity: the header the dev identity adapter reads.
# This is not production authentication -- see docs/INTEGRATION.md.
DEV_IDENTITY_HEADER=X-UC08-Subject
