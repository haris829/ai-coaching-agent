{
  "name": "courses-quiz-agent",
  "private": true,
  "version": "1.0.0",
  "description": "Courses Quiz Agent — UC-01 to UC-10 as one system (FastAPI backend + a minimal React test UI), with UC-11 as the cross-cutting integrity layer",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "node scripts/py.mjs --cwd backend -m uvicorn app.main:app --reload --port 8000",
    "dev:web": "npm run dev --workspace @quiz-agent/frontend",
    "start": "node scripts/py.mjs --cwd backend -m scripts.start",
    "migrate": "node scripts/py.mjs --cwd backend -m alembic upgrade head",
    "seed": "node scripts/py.mjs --cwd backend -m scripts.seed",
    "test": "npm-run-all test:api test:web",
    "test:api": "node scripts/py.mjs -m pytest backend",
    "test:web": "npm run test --workspace @quiz-agent/frontend",
    "lint": "node scripts/py.mjs --cwd backend -m ruff check app tests scripts",
    "format": "node scripts/py.mjs --cwd backend -m ruff format app tests scripts",
    "verify:e2e": "node scripts/py.mjs --cwd backend -m scripts.verify_e2e",
    "smoke:ui": "node scripts/py.mjs --cwd backend -m scripts.smoke_ui",
    "verify:deployment": "node scripts/py.mjs --cwd backend -m scripts.verify_deployment",
    "verify:postgres": "node scripts/py.mjs --cwd backend -m scripts.verify_postgres",
    "verify:uc02-uc03": "node scripts/py.mjs --cwd backend -m scripts.verify_uc02_uc03",
    "verify:uc-remaining": "node scripts/py.mjs --cwd backend -m scripts.verify_uc_remaining",
    "deploy:railway": "node scripts/deploy-railway.mjs",
    "typecheck": "npm run typecheck --workspace @quiz-agent/frontend",
    "build:web": "npm run build --workspace @quiz-agent/frontend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.11"
  },
  "allowScripts": {
    "esbuild": true
  }
}
